---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrestigeImage from '../components/PrestigeImage.astro';
---

<BaseLayout title="Isaac Defined Your Today. Esther Will Define Your Survival. | Scott Bales">

  <!-- ════════════════════════════════════════════════════════
       SECTION 1: THE HERO — Option D (The Generational Pincer)
       Full viewport. Two names. Two sentences. The pincer.
       ════════════════════════════════════════════════════════ -->
  <section class="min-h-screen flex items-center justify-center px-8">
    <div class="max-w-4xl text-center">
      <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl leading-[1.05] mb-8">
        <span class="text-accent">Isaac</span> defined your today.<br />
        <span class="text-accent">Esther</span> will define your survival.
      </h1>
      <p class="font-sans text-lg md:text-xl text-gray-400 max-w-2xl mx-auto leading-relaxed mb-12">
        One was born with a screen in his hand.<br />
        The other was born the same day as ChatGPT.<br />
        Your organization is caught between both.
      </p>
      <a
        href="/origin-story-jenson-human-algorithm"
        class="inline-block font-sans text-xs tracking-[0.15em] uppercase px-8 py-4 border border-accent text-accent hover:bg-accent hover:text-black transition-colors"
      >
        Meet the Pincer
      </a>
    </div>
  </section>

  <!-- Hero Image -->
  <section class="border-t border-white/5">
    <div class="swiss-grid py-0">
      <div class="content-col fade-in">
        <PrestigeImage
          src="/images/scott-bales-stage.jpg"
          alt="Scott Bales on stage"
          aspect="3/2"
        />
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════
       SECTION 2: THE SHIFT — Isaac
       ════════════════════════════════════════════════════════ -->
  <section id="isaac" class="section-pad border-t border-white/5">
    <div class="swiss-grid">
      <div class="content-col fade-in">
        <p class="font-sans text-xs tracking-[0.2em] uppercase text-accent mb-6">The Shift</p>
        <h2 class="font-serif text-4xl md:text-5xl mb-8">
          <span class="text-accent">Isaac</span> is nineteen.
        </h2>
        <p class="font-sans text-lg text-gray-400 leading-relaxed mb-8">
          He has never walked into a bank. He has never filled out a form
          without asking why. He has never accepted a product that asked him
          to adapt to it rather than the other way around. He is not
          hypothetical. He is the demographic reality sitting in your customer
          data, your employee pipeline, and your competitor's founding team.
        </p>
        <a
          href="/isaac-the-consumer-who-will-replace-your-customer"
          class="font-sans text-xs tracking-[0.15em] uppercase text-accent hover:text-white transition-colors"
        >
          Meet Isaac &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════
       SECTION 3: THE OUTCOME — Esther
       ════════════════════════════════════════════════════════ -->
  <section id="esther" class="section-pad border-t border-white/5">
    <div class="swiss-grid">
      <div class="content-col fade-in">
        <p class="font-sans text-xs tracking-[0.2em] uppercase text-accent mb-6">The Outcome</p>
        <h2 class="font-serif text-4xl md:text-5xl mb-8">
          <span class="text-accent">Esther</span> was born on November&nbsp;30,&nbsp;2022.
        </h2>
        <p class="font-sans text-lg text-gray-400 leading-relaxed mb-8">
          So was ChatGPT. She will not remember a world before generative AI.
          She will not distinguish between using a tool and having a conversation.
          She will not interact with your brand directly. Her agent will. And if
          it finds your product excludes, Esther will never know your company
          existed.
        </p>
        <a
          href="/esther-and-the-agentic-future"
          class="font-sans text-xs tracking-[0.15em] uppercase text-accent hover:text-white transition-colors"
        >
          Meet Esther &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════
       SECTION 4: THE EVIDENCE — Proof Wall
       3x2 Swiss Grid. Company name above quote.
       ════════════════════════════════════════════════════════ -->
  <section id="proof" class="section-pad border-t border-white/5">
    <div class="swiss-grid">
      <div class="content-col fade-in">
        <p class="font-sans text-xs tracking-[0.2em] uppercase text-accent mb-12">The Evidence</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">

          <!-- Microsoft -->
          <blockquote class="border-l border-white/10 pl-6">
            <p class="font-sans text-xs tracking-[0.15em] uppercase text-gray-400 mb-3">Microsoft</p>
            <p class="font-serif text-lg text-white leading-relaxed">
              "Content and stage presence are first class."
            </p>
          </blockquote>

          <!-- Google -->
          <blockquote class="border-l border-white/10 pl-6">
            <p class="font-sans text-xs tracking-[0.15em] uppercase text-gray-400 mb-3">Google</p>
            <p class="font-serif text-lg text-white leading-relaxed">
              "It's tough to make talks in the Financial space exciting, and Scott delivered."
            </p>
          </blockquote>

          <!-- Visa -->
          <blockquote class="border-l border-white/10 pl-6">
            <p class="font-sans text-xs tracking-[0.15em] uppercase text-gray-400 mb-3">Visa</p>
            <p class="font-serif text-lg text-white leading-relaxed">
              "Deep context, clever insights, and relevant thinking. Speaks with genuine passion."
            </p>
          </blockquote>

          <!-- Brett King -->
          <blockquote class="border-l border-white/10 pl-6">
            <p class="font-sans text-xs tracking-[0.15em] uppercase text-gray-400 mb-3">Brett King</p>
            <p class="font-serif text-lg text-white leading-relaxed">
              "Instinctually understands the mobile space better than anyone else in Asia."
            </p>
          </blockquote>

          <!-- Vodafone -->
          <blockquote class="border-l border-white/10 pl-6">
            <p class="font-sans text-xs tracking-[0.15em] uppercase text-gray-400 mb-3">Vodafone</p>
            <p class="font-serif text-lg text-white leading-relaxed">
              "Very engaging and thought-provoking. We would readily recommend Scott for future events."
            </p>
            <p class="font-sans text-xs text-gray-400 mt-2">Hart Wilcox, APAC NZ Gigabit Society Summit</p>
          </blockquote>

          <!-- Standard Chartered -->
          <blockquote class="border-l border-white/10 pl-6">
            <p class="font-sans text-xs tracking-[0.15em] uppercase text-gray-400 mb-3">Standard Chartered</p>
            <p class="font-serif text-lg text-white leading-relaxed">
              "Innovative thinker challenging conventional norms. Understanding of technology is profound."
            </p>
          </blockquote>

        </div>

        <div class="mt-12">
          <a
            href="/proof-results-client-testimonials"
            class="font-sans text-xs tracking-[0.15em] uppercase text-accent hover:text-white transition-colors"
          >
            All client proof &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════
       SECTION 5: THE INVITATION — Book
       ════════════════════════════════════════════════════════ -->
  <section id="book" class="section-pad border-t border-white/5">
    <div class="swiss-grid">
      <div class="content-col text-center fade-in">
        <h2 class="font-serif text-4xl md:text-5xl mb-6">
          One conversation. No pitch deck.
        </h2>
        <p class="font-sans text-lg text-gray-400 max-w-xl mx-auto leading-relaxed mb-12">
          No PDF will tell you what Scott will do for <em>your</em> audience.
          The only way to know is to talk.
        </p>
        <a
          href="/book-scott-bales-keynote-speaker"
          class="inline-block font-sans text-xs tracking-[0.15em] uppercase px-8 py-4 border border-accent text-accent hover:bg-accent hover:text-black transition-colors"
        >
          Book Scott Bales
        </a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════
       PROOF BAR — Rotating client logos (placeholder)
       ════════════════════════════════════════════════════════ -->
  <div class="border-t border-white/5 py-8">
    <div class="max-w-[1440px] mx-auto px-8 flex items-center justify-center gap-12 flex-wrap">
      <span class="font-sans text-xs tracking-[0.15em] uppercase text-gray-400/40">Microsoft</span>
      <span class="font-sans text-xs tracking-[0.15em] uppercase text-gray-400/40">Google</span>
      <span class="font-sans text-xs tracking-[0.15em] uppercase text-gray-400/40">Visa</span>
      <span class="font-sans text-xs tracking-[0.15em] uppercase text-gray-400/40">AIA</span>
      <span class="font-sans text-xs tracking-[0.15em] uppercase text-gray-400/40">Standard Chartered</span>
      <span class="font-sans text-xs tracking-[0.15em] uppercase text-gray-400/40">Vodafone</span>
    </div>
  </div>

</BaseLayout>
